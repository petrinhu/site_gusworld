#!/usr/bin/env bash
# .githooks/pre-push - roda o gate scripts/preci.sh antes de todo `git push`.
#
# Quem liga: scripts/instalar-gancho.sh grava .git/hooks/pre-push com uma linha
# que executa ESTE arquivo. Nao use `core.hooksPath` local (sobrepoe o global e
# desliga em silencio os ganchos globais) nem link simbolico (a raiz se perde).
# A raiz vem do git, nao do caminho deste arquivo, entao funciona de qualquer
# jeito que for chamado.

set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/preci.sh"
